# Copie para secrets.toml e preencha. secrets.toml NÃO é versionado (.gitignore).

# "mock" (padrão) usa dados em memória; "firebase" usa o Firestore.
data_source = "mock"

# Necessário apenas quando data_source = "firebase".
# Cole aqui o conteúdo do service account JSON do Firebase.
# [firebase]
# type = "service_account"
# project_id = "transporte-sjc"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "firebase-adminsdk-xxxx@transporte-sjc.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
